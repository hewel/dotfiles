window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Chrome Wayland notification toasts: empty app_id + title, steal focus as tiled columns.
// See: niri event-stream WindowOpenedOrChanged with pid=chrome, size ~360x142.
window-rule {
    match app-id="^$" title="^$"
    open-floating true
    open-focused false
    default-floating-position x=16 y=16 relative-to="top-right"
}

layer-rule {
    match namespace="^noctalia-backdrop*"
    place-within-backdrop true
}

// Raycast-style anyrun: dark HUD, rounded shadow. Keep the
// surface tight (close_on_click off) so blur does not cover the screen.
layer-rule {
    match namespace="^anyrun$"

    geometry-corner-radius 16

    shadow {
        on
        softness 40
        spread 4
        offset x=0 y=16
        color "#00000066"
    }

    background-effect {
        blur true
        xray false
        noise 0.02
    }
}
