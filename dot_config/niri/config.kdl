// Niri entry point. Every include below is live.
// cfg/outputs.kdl is the only machine-specific file (connector names and layout).

include "cfg/autostart.kdl"
include "cfg/input.kdl"
include "cfg/layout.kdl"
include "cfg/overview.kdl"
include "cfg/rules.kdl"
include "cfg/binds.kdl"
include "cfg/outputs.kdl"

environment {
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
}

hotkey-overlay {
    skip-at-startup
}

blur {
    passes 4
    offset 6
}

debug {
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial
}
