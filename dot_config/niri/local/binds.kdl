binds {
    // ─── Noctalia v5 IPC (migrated from DMS / noctalia-shell v4) ───
    Super+D hotkey-overlay-title="Launcher: Noctalia" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S hotkey-overlay-title="Control Center: Noctalia" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma hotkey-overlay-title="Settings: Noctalia" { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab hotkey-overlay-title="Window Switcher: Noctalia" { spawn-sh "noctalia msg window-switcher"; }
    Super+P hotkey-overlay-title="Session Menu: Noctalia" { spawn-sh "noctalia msg panel-toggle session"; }
    Super+V hotkey-overlay-title="Clipboard: Noctalia" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Shift+Q hotkey-overlay-title="Session Menu: Noctalia" { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+ALT+L hotkey-overlay-title="Lock Screen: Noctalia" { spawn-sh "noctalia msg session lock"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // Unmapped DMS plugin (no Noctalia equivalent): dankTranslateAI translateSelection
    // Previous bind: Mod+Shift+T -> dms ipc call dankTranslateAI translateSelection

    // ─── Applications (preserved from the previously effective dms/binds.kdl) ───
    Mod+T hotkey-overlay-title="Open Terminal: Ghostty" { spawn "ghostty"; }
    Mod+B hotkey-overlay-title="Open Browser: zen-browser" { spawn "zen-browser"; }
    Mod+E hotkey-overlay-title="File Manager: Nautilus" { spawn "nautilus"; }
    Mod+R hotkey-overlay-title="Open App Launcher: Anyrun" { spawn-sh "anyrun"; }

    // ─── Workspaces ───
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+CTRL+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+CTRL+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-workspace-down; }
    Mod+Shift+WheelScrollUp { focus-workspace-up; }
    Mod+TAB { focus-workspace-previous; }
    Super+Shift+1 { move-column-to-workspace 1; }
    Super+Shift+2 { move-column-to-workspace 2; }
    Super+Shift+3 { move-column-to-workspace 3; }
    Super+Shift+4 { move-column-to-workspace 4; }
    Super+Shift+5 { move-column-to-workspace 5; }
    Super+Shift+6 { move-column-to-workspace 6; }
    Super+Shift+7 { move-column-to-workspace 7; }
    Super+Shift+8 { move-column-to-workspace 8; }
    Super+Shift+9 { move-column-to-workspace 9; }

    // ─── Screenshots (niri built-in; Print region+satty lives in config.kdl) ───
    CTRL+Shift+1 { screenshot; }
    CTRL+Shift+2 { screenshot-screen; }
    CTRL+Shift+3 { screenshot-window; }

    // ─── Window movement and focus ───
    Mod+C { center-column; }
    Mod+CTRL+C { center-visible-columns; }
    Mod+CTRL+Down { move-window-down; }
    Mod+CTRL+End { move-column-to-last; }
    Mod+CTRL+H { move-column-left; }
    Mod+CTRL+Home { move-column-to-first; }
    Mod+CTRL+J { move-window-down; }
    Mod+CTRL+K { move-window-up; }
    Mod+CTRL+L { move-column-right; }
    Mod+CTRL+Left { move-column-left; }
    Mod+CTRL+M { expand-column-to-available-width; }
    Mod+CTRL+Right { move-column-right; }
    Mod+CTRL+Shift+WheelScrollDown { move-column-right; }
    Mod+CTRL+Shift+WheelScrollUp { move-column-left; }
    Mod+CTRL+UP { move-window-up; }
    Mod+CTRL+WheelScrollLeft { move-column-left; }
    Mod+CTRL+WheelScrollRight { move-column-right; }
    Mod+Down { focus-window-down; }
    Mod+End { focus-column-last; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+F { fullscreen-window; }
    Mod+H { focus-column-left; }
    Mod+Home { focus-column-first; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Q { close-window; }
    Mod+Right { focus-column-right; }
    Mod+Shift+CTRL+Down { move-column-to-monitor-down; }
    Mod+Shift+CTRL+Left { move-column-to-monitor-left; }
    Mod+Shift+CTRL+Right { move-column-to-monitor-right; }
    Mod+Shift+CTRL+UP { move-column-to-monitor-up; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+F { toggle-window-floating; }
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+UP { focus-monitor-up; }
    Mod+Up { focus-window-up; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-column-left; }
    Super+M hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+Shift+P { power-off-monitors; }
    CTRL+ALT+Delete { quit; }
    Mod+ESCAPE allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+ESCAPE { show-hotkey-overlay; }
    Mod+X repeat=false { toggle-overview; }
}
