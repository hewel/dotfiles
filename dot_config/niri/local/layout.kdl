// Static layout + colors previously generated by DMS.
// Values captured from ~/.config/niri/dms/layout.kdl and dms/colors.kdl.
prefer-no-csd

layout {
    gaps 6
    background-color "transparent"

    focus-ring {
        off
    }

    border {
        on
        width 0.5

        active-color "#ffffff28"
        inactive-color "#ffffff10"
        urgent-color "#ff5f5790"
    }

    shadow {
        on

        softness 36
        spread -1
        offset x=0 y=8

        color "#00000055"
        inactive-color "#00000028"
    }

    tab-indicator {
        active-color   "#39608f"
        inactive-color "#73777f"
        urgent-color   "#ba1a1a"
        gap 0
        // position "top"
        // place-within-column
    }

    insert-hint {
        color "#39608f80"
    }
}


window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}
